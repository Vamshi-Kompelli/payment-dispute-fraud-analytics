Total Transactions = COUNTROWS(transactions)
Transaction Value INR = SUM(transactions[amount_inr])
Total Disputes = COUNTROWS(disputes)
Disputed Value INR = SUMX(disputes, RELATED(transactions[amount_inr]))
Fraud Disputes = CALCULATE([Total Disputes], disputes[fraud_flag] = TRUE())
Fraud Dispute Rate = DIVIDE([Fraud Disputes], [Total Disputes])
Confirmed Loss INR = SUM(disputes[confirmed_loss_inr])
Open Queue = CALCULATE([Total Disputes], disputes[status] IN {"OPEN","UNDER_REVIEW"})
Average Risk Score = AVERAGE(disputes[risk_score])
Average Resolution Days = AVERAGEX(FILTER(disputes, NOT ISBLANK(disputes[resolution_date])), DATEDIFF(disputes[opened_date], disputes[resolution_date], DAY))
High Risk Open Queue = CALCULATE([Total Disputes], disputes[risk_score] >= 70, disputes[status] IN {"OPEN","UNDER_REVIEW"})
